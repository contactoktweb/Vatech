# Copia este archivo como .env.local (desarrollo) y agrega las mismas variables en Vercel (producción).

# ─── Sanity ────────────────────────────────────────────────────────────────
# ID del proyecto: sanity.io/manage → tu proyecto → "Project ID"
NEXT_PUBLIC_SANITY_PROJECT_ID=
# Dataset donde vive el contenido
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permiso de escritura (Editor) para subir el contenido inicial con `pnpm sanity:seed`.
# sanity.io/manage → API → Tokens → Add API token. No lo publiques ni lo pongas con prefijo NEXT_PUBLIC_.
SANITY_API_WRITE_TOKEN=
# (Opcional) Secreto del webhook para actualizar el sitio al instante al publicar en Sanity
SANITY_REVALIDATE_SECRET=

# ─── Sitio ─────────────────────────────────────────────────────────────────
# Dominio oficial para SEO (sitemap, URLs canónicas, datos para Google)
NEXT_PUBLIC_SITE_URL=https://www.vatechcolombia.com.co
